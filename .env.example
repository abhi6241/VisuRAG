# VisuRAG backend environment. Copy to `.env` (gitignored, never commit).
# Only set what you need — every variable has a working offline default.

# --- Vector store ---
# memory (tests) | path (default, data/qdrant, no Docker) | url (external)
# VISURAG_QDRANT_MODE=path
# VISURAG_QDRANT_PATH=data/qdrant
# VISURAG_QDRANT_URL=http://localhost:6333
# VISURAG_QDRANT_API_KEY=

# --- Encoders / reranker (hash/heuristic = offline; others download once) ---
# VISURAG_TEXT_ENCODER=hash
# VISURAG_TEXT_MODEL=BAAI/bge-small-en-v1.5
# VISURAG_IMAGE_ENCODER=hash
# VISURAG_IMAGE_MODEL=Qdrant/clip-ViT-B-32-vision
# VISURAG_RERANKER=heuristic

# --- VLM: echo (default, offline) | ollama | groq | openai-compatible ---
# VISURAG_VLM_PROVIDER=echo
# Ollama (local server): VISURAG_VLM_PROVIDER=ollama
# VISURAG_OLLAMA_BASE_URL=http://localhost:11434
# VISURAG_OLLAMA_MODEL=llama3.2-vision
# Groq (hosted, free key at https://console.groq.com/keys):
# VISURAG_VLM_PROVIDER=groq
# VISURAG_GROQ_API_KEY=gsk_...
# VISURAG_GROQ_MODEL=qwen/qwen3.8-27b
# Generic OpenAI-style endpoint (vLLM, LM Studio, hosted):
# VISURAG_OPENAI_COMPATIBLE_BASE_URL=
# VISURAG_OPENAI_COMPATIBLE_MODEL=
# VISURAG_OPENAI_COMPATIBLE_API_KEY=

# --- Ingestion / retrieval budgets ---
# VISURAG_INGEST_DPI=150

# --- Security (safe defaults: open auth, 120 req/min per IP) ---
# VISURAG_API_KEY=
# VISURAG_RATE_LIMIT_PER_MIN=120
